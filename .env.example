# Tabayyun AI environment template
# Copy this file to .env.local for local development. Never commit real secrets.
# All credentials are server-only; never rename them with a NEXT_PUBLIC_ prefix.

# -----------------------------------------------------------------------------
# Application identity
# Required for public deployment. APP_URL must be the stable HTTPS origin with
# no path. Operator details are displayed on the public legal pages.
# -----------------------------------------------------------------------------
APP_URL=http://localhost:3000
APP_OPERATOR_NAME=
APP_SUPPORT_EMAIL=
APP_POSTAL_ADDRESS=

# -----------------------------------------------------------------------------
# Persistence
# Required for accounts, approved-source verification, server research, and
# distributed production quotas. Use an Atlas mongodb+srv:// URI.
# -----------------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB=tabayyun

# Localhost-only development bypass for /research. Never enables production
# access and should remain false for normal/account-based operation.
TABAYYUN_RESEARCH_SINGLE_USER=false

# -----------------------------------------------------------------------------
# AI and OCR
# Groq enables claim extraction, grounded analysis, comparisons, and briefs.
# OCR.space is needed only for screenshot OCR; pasted text needs no OCR key.
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_EXTRACTION_MODEL=openai/gpt-oss-20b
GROQ_ANALYSIS_MODEL=openai/gpt-oss-120b
OCR_SPACE_API_KEY=

# -----------------------------------------------------------------------------
# Approved source providers
# Set only the providers used by your reviewed resource records.
# Quran Foundation requires both credentials. Prelive covers limited content.
# -----------------------------------------------------------------------------
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_ENV=prelive
SUNNAH_API_KEY=
UMMAH_API_KEY=

# Retained Shamela/Parse adapter configuration. Shamela is currently outside
# the documented corpus milestone and its wildcard resource is disabled. A key
# alone does not approve a source or make it eligible for evidence.
PARSE_API_KEY=
SHAMEELA_API_KEY=
SHAMELA_MAX_PAGES=3

# -----------------------------------------------------------------------------
# Development Chrome extension
# Cross-origin extension API access is accepted only by next dev on localhost
# and only from this exact extension origin. The backend origin is embedded at
# extension build time; extension/build.cjs does not load .env files itself.
# -----------------------------------------------------------------------------
TABAYYUN_EXTENSION_ORIGIN=chrome-extension://replace_with_extension_id
TABAYYUN_BACKEND_ORIGIN=http://localhost:3000

# Server-only OCR.space key. No key is needed for pasted text or local search.
# Vercel: configure these in Project Settings > Environment Variables, then redeploy.
# Required for public deployment. Replace localhost with your stable HTTPS origin.
APP_URL=http://localhost:3000
APP_OPERATOR_NAME=
APP_SUPPORT_EMAIL=
APP_POSTAL_ADDRESS=
# Atlas is required for all paid endpoints in production (shared request budgets).
OCR_SPACE_API_KEY=
# Optional server-only Groq configuration. Never use NEXT_PUBLIC_ for credentials.
GROQ_API_KEY=
GROQ_EXTRACTION_MODEL=openai/gpt-oss-20b
GROQ_ANALYSIS_MODEL=openai/gpt-oss-120b
# Development only. Replace with the extension ID shown in chrome://extensions.
# Requests from this exact extension origin are accepted only on localhost in next dev.
TABAYYUN_EXTENSION_ORIGIN=chrome-extension://replace_with_extension_id
# Build-time public backend origin for npm run build:extension (localhost HTTP only).
TABAYYUN_BACKEND_ORIGIN=http://localhost:3000
PARSE_API_KEY=
# Phase 4A: server-only MongoDB Atlas and official source APIs.
MONGODB_URI=
MONGODB_DB=tabayyun
# Account sign-in enables research in production. This optional bypass is localhost development only.
TABAYYUN_RESEARCH_SINGLE_USER=false
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_ENV=prelive
SUNNAH_API_KEY=
# Parse remains disabled until the configured API's OpenAPI contract is reviewed.
# No arbitrary URL extraction or automatic paid jobs are enabled.
